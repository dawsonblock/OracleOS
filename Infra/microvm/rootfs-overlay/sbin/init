#!/bin/sh
set -eu

mkdir -p /proc /sys /dev /tmp /run
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

if [ -x /usr/local/bin/oracle-guest-runner.sh ]; then
    exec /usr/local/bin/oracle-guest-runner.sh
fi

echo "oracle microvm init: missing /usr/local/bin/oracle-guest-runner.sh" >&2
poweroff -f 2>/dev/null || reboot -f 2>/dev/null || exit 1
